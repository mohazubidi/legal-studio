# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (browser-safe). The app never uses the service-role key:
# every request runs under the signed-in user's session so Row Level Security applies.
# Never add SUPABASE_SERVICE_ROLE_KEY (or any secret) with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used for the email-confirmation redirect when the Origin header is unavailable.
NEXT_PUBLIC_SITE_URL=

# AI generation (server-side only, never NEXT_PUBLIC_). Without a key the tools
# show an "unavailable" state; nothing is generated or faked.
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5) and effort: low | medium | high | xhigh | max (default high).
LEGAL_STUDIO_AI_MODEL=
LEGAL_STUDIO_AI_EFFORT=

# Audio transcription (server-side only). Any OpenAI-compatible /audio/transcriptions
# endpoint over HTTPS, e.g. https://api.openai.com/v1/audio/transcriptions with model whisper-1.
# Without these, audio sources are kept but marked "transcription unavailable".
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_LANGUAGE=

# Optional, development only: browse the workspace UI without Supabase (`next dev` only;
# ignored by production builds and whenever Supabase is configured).
LOCAL_PREVIEW=

# Optional, tests only: a disposable Postgres server for `npx vitest run tests/db`.
# `npm run test:db` provisions a throwaway one automatically.
TEST_DATABASE_URL=
