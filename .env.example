# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (browser-safe). The app never uses the service-role key:
# every request runs under the signed-in user's session so Row Level Security applies.
# Never add SUPABASE_SERVICE_ROLE_KEY (or any secret) with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used for the email-confirmation redirect when the Origin header is unavailable.
NEXT_PUBLIC_SITE_URL=

# Optional, development only: browse the workspace UI without Supabase (`next dev` only;
# ignored by production builds and whenever Supabase is configured).
LOCAL_PREVIEW=

# Optional, tests only: a disposable Postgres server for `npx vitest run tests/db`.
# `npm run test:db` provisions a throwaway one automatically.
TEST_DATABASE_URL=
