# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (browser-safe). Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Optional: used for the email-confirmation redirect when the Origin header is unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
